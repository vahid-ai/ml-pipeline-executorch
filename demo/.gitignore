##########################
# KEDRO PROJECT

# ignore all local configuration
conf/local/**
!conf/local/.gitkeep
.telemetry

# ignore potentially sensitive credentials files
conf/**/*credentials*

# ignore everything in the following folders
data/**

# except their sub-folders
!data/**/

# also keep all .gitkeep files
!.gitkeep

# ignore kedro-viz metadata
.viz

# ignore file based logs
*.log

##########################
# ML/Data Science specific

# Model artifacts
models/**
!models/.gitkeep
*.pth
*.pt
*.ckpt
*.safetensors
*.bin
*.onnx
*.pb
*.h5
*.keras
*.joblib
*.sav
checkpoints/
saved_models/

# MLflow
mlruns/**
!mlruns/.gitkeep
mlflow.db
backend-store/

# Weights & Biases
wandb/

# TensorBoard
tensorboard/
logs/
*.tfevents.*

# Data files
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.npy
*.npz
*.zarr/
*.db
*.sqlite
*.sqlite3

# Feast
feature_store/
online_store.db
registry.db
*.parquet.crc

# Great Expectations
great_expectations/uncommitted/
great_expectations/checkpoints/

# DVC
.dvc/
.dvcignore
*.dvc

